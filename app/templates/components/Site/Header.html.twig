{% set focus = 'outline-offset-2 outline-(--px-brand) focus-visible:outline-2' %}
{% set source_url = 'https://github.com/mykiwi/rssbase' %}
{# Placeholder until the project has a Bluesky account to link. #}
{% set bluesky_url = 'https://bsky.app' %}
{# The languages of the menu, by locale. "english" lets a search in English find them. #}
{% set languages = {
    en: {name: 'English', english: 'English', flag: '🌐'},
    fr: {name: 'Français', english: 'French', flag: '🇫🇷'},
} %}
{# A language link opens the same page on the site of the other language. #}
{% set route = app.request.attributes.get('_canonical_route') ?? 'home' %}
{% set route_params = app.request.attributes.get('_route_params') ?? {} %}
{# No changelog file or release yet: the commit history is the changelog. #}
{% set links = [
    {
        label: 'nav.changelog'|trans,
        url: source_url ~ '/commits/main',
        outlined: true,
        icon: '<path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/>'
    },
    {
        label: 'nav.source'|trans,
        url: source_url,
        outlined: false,
        icon: '<path d="M23.546 10.93L13.067.452c-.604-.603-1.582-.603-2.188 0L8.708 2.627l2.76 2.76c.645-.215 1.379-.07 1.889.441.516.515.658 1.258.438 1.9l2.658 2.66c.645-.223 1.387-.078 1.9.435.721.72.721 1.884 0 2.604-.719.719-1.881.719-2.6 0-.539-.541-.674-1.337-.404-1.996L12.86 8.955v6.525c.176.086.342.203.488.348.713.721.713 1.883 0 2.6-.719.721-1.889.721-2.609 0-.719-.719-.719-1.879 0-2.598.182-.18.387-.316.605-.406V8.835c-.217-.091-.424-.222-.6-.401-.545-.545-.676-1.342-.396-2.009L7.636 3.7.45 10.881c-.6.605-.6 1.584 0 2.189l10.48 10.477c.604.604 1.582.604 2.186 0l10.43-10.43c.605-.603.605-1.582 0-2.187"/>'
    },
    {
        label: 'nav.social'|trans,
        url: bluesky_url,
        outlined: false,
        icon: '<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/>'
    },
] %}

{# The "calm" targets keep the pixel field of the home page away from the header; other pages have no field. #}
<header class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="{{ path('home') }}" data-pixel-field-target="calm" class="inline-flex h-11 items-center font-semibold {{ focus }}"><span class="text-(--px-brand)">Rss</span>Base</a>
    <nav aria-label="{{ 'nav.elsewhere'|trans }}" data-pixel-field-target="calm" class="relative -mr-3 flex items-center">
        <div data-controller="language-menu">
            <button type="button" data-language-menu-target="button" data-action="language-menu#toggle" aria-expanded="false" aria-controls="language-menu" class="group relative flex size-11 items-center justify-center text-(--px-text-2) transition-colors hover:text-(--px-brand) aria-expanded:bg-(--px-surface) aria-expanded:text-(--px-text) {{ focus }}">
                <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                <span class="pointer-events-none absolute top-full left-1/2 mt-1 -translate-x-1/2 translate-y-1 border border-(--px-line) bg-(--px-surface) px-2.5 py-1.5 text-xs whitespace-nowrap text-(--px-text) opacity-0 transition duration-150 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 group-aria-expanded:invisible">
                    {{ 'nav.language'|trans }}
                </span>
            </button>
            {# Positioned from the navigation, not from the button: the panel lines up with the right edge of the icons. #}
            <div id="language-menu" data-language-menu-target="panel" hidden class="absolute top-full right-3 z-10 mt-1 w-72 max-w-[calc(100vw-2rem)] border border-(--px-line) bg-(--px-panel) pb-2 text-left">
                <label class="flex items-center gap-3 border-b border-(--px-line) px-4 text-(--px-text-2) focus-within:border-(--px-brand)">
                    <svg viewBox="0 0 24 24" class="size-4 shrink-0 fill-none stroke-current stroke-2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="search" data-language-menu-target="search" data-action="input->language-menu#filter keydown.enter->language-menu#choose" aria-label="{{ 'nav.language_search'|trans }}" placeholder="{{ 'nav.language_search'|trans }}" autocomplete="off" class="h-12 w-full bg-transparent text-sm text-(--px-text) outline-none placeholder:text-(--px-text-2)">
                </label>

                <p class="px-4 pt-3 pb-1.5 text-xs text-(--px-text-2)">{{ 'nav.language_current'|trans }}</p>
                <a href="{{ path(route, route_params) }}" lang="{{ app.locale }}" aria-current="true" class="flex h-11 items-center gap-3 bg-(--px-surface) px-4 text-sm text-(--px-brand) {{ focus }}">
                    <span aria-hidden="true">{{ languages[app.locale].flag }}</span>
                    {{ languages[app.locale].name }}
                </a>

                <p class="px-4 pt-3 pb-1.5 text-xs text-(--px-text-2)">{{ 'nav.language_others'|trans }}</p>
                <ul>
                    {% for locale, language in languages|filter((language, locale) => locale != app.locale) %}
                        <li data-language-menu-target="item" data-search="{{ language.name }} {{ language.english }} {{ locale }}">
                            <a href="{{ path(route, route_params|merge({_locale: locale})) }}" lang="{{ locale }}" hreflang="{{ locale }}" class="flex h-11 items-center gap-3 px-4 text-sm transition-colors hover:bg-(--px-surface) {{ focus }}">
                                <span aria-hidden="true">{{ language.flag }}</span>
                                {{ language.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                <p data-language-menu-target="empty" hidden class="px-4 py-3 text-sm text-(--px-text-2)">{{ 'nav.language_none'|trans }}</p>
            </div>
        </div>
        {% for link in links %}
            <a href="{{ link.url }}" class="group relative flex size-11 items-center justify-center text-(--px-text-2) transition-colors hover:text-(--px-brand) {{ focus }}">
                <svg viewBox="0 0 24 24" class="size-5 {{ link.outlined ? 'fill-none stroke-current stroke-2' : 'fill-current' }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ link.icon|raw }}</svg>
                {# The name of the link, shown under the icon on hover and on keyboard focus. The last one hangs from the right edge to stay on screen. #}
                <span class="pointer-events-none absolute top-full mt-1 translate-y-1 border border-(--px-line) bg-(--px-surface) px-2.5 py-1.5 text-xs whitespace-nowrap text-(--px-text) opacity-0 transition duration-150 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 {{ loop.last ? 'right-1' : 'left-1/2 -translate-x-1/2' }}">
                    {{ link.label }}
                </span>
            </a>
        {% endfor %}
    </nav>
</header>
