<!DOCTYPE html>
<html lang="{{ app.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ app_name }}{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><rect width=%2224%22 height=%2224%22 rx=%225%22 fill=%22%23b45309%22/><g fill=%22none%22 stroke=%22%23fff%22 stroke-width=%222.5%22 stroke-linecap=%22round%22><path d=%22M6 11.5a6.5 6.5 0 0 1 6.5 6.5%22/><path d=%22M6 5.5A12.5 12.5 0 0 1 18.5 18%22/></g><circle cx=%226.75%22 cy=%2217.25%22 r=%221.75%22 fill=%22%23fff%22/></svg>">
        {# Set by FrankenPHP when the Caddyfile enables hot_reload, in development only. #}
        {% set hot_reload_url = app.request ? app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if hot_reload_url %}
            {# A classic script: a module here would start before the import map, which Firefox then ignores. #}
            <script>
                new EventSource('{{ hot_reload_url|e('js') }}').onmessage = () => location.reload();
            </script>
        {% endif %}
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
