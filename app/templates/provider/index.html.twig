{% extends 'site.html.twig' %}

{% block title %}{{ 'providers.page_title'|trans }}{% endblock %}

{% block main %}
    {% set focus = 'outline-offset-2 outline-(--px-brand) focus-visible:outline-2' %}
    {{ include('provider/_marks.html.twig') }}

    <h1 class="text-3xl font-semibold tracking-tight">{{ 'providers.title'|trans }}</h1>
    <p class="mt-3 text-(--px-text-2)">{{ 'providers.intro'|trans }}</p>

    {% if error %}
        <p role="alert" class="mt-6 border border-(--px-error) px-4 py-3 text-sm text-(--px-error)">{{ error|trans }}</p>
    {% endif %}

    <div data-controller="provider-filter">
        {# One literal key per provider and region, so that the translation check sees them. #}
        {% set descriptions = {
            eurosky: 'providers.description.eurosky'|trans,
            bluesky: 'providers.description.bluesky'|trans,
            blacksky: 'providers.description.blacksky'|trans,
            npmx: 'providers.description.npmx'|trans,
        } %}
        {% set labels = {recommended: 'providers.label.recommended'|trans, popular: 'providers.label.popular'|trans} %}
        {% set regions = {eu: 'providers.region.eu'|trans, us: 'providers.region.us'|trans} %}
        {# Width and height of each flag at the height of a line of small text, in its own proportions (3:2, 19:10). #}
        {% set flag_sizes = {eu: [21, 14], us: [27, 14]} %}
        {% set filters = [
            {region: null, label: 'providers.filter.all'|trans},
            {region: 'eu', label: 'providers.filter.eu'|trans},
            {region: 'us', label: 'providers.filter.us'|trans},
        ] %}

        <nav aria-label="{{ 'providers.filter.label'|trans }}" class="mt-8 flex border border-(--px-line) p-1" data-test="provider-filter">
            {% for filter in filters %}
                <a
                    href="{{ path('providers', filter.region ? {region: filter.region} : {}) }}"
                    {% if filter.region == region?.value %}aria-current="page"{% endif %}
                    {% if filter.region %}data-region="{{ filter.region }}"{% endif %}
                    data-provider-filter-target="filter"
                    data-action="provider-filter#choose"
                    class="flex h-11 flex-1 items-center justify-center gap-2 text-sm text-(--px-text-2) transition-colors hover:text-(--px-text) aria-[current=page]:bg-(--px-surface) aria-[current=page]:text-(--px-brand) {{ focus }}"
                >
                    {% if filter.region %}
                        <svg width="{{ flag_sizes[filter.region][0] }}" height="{{ flag_sizes[filter.region][1] }}" aria-hidden="true"><use href="#flag-{{ filter.region }}"/></svg>
                    {% endif %}
                    {{ filter.label }}
                </a>
            {% endfor %}
        </nav>

        {# Room above each card for the label that sits on its top border. #}
        <ul class="mt-8 flex flex-col gap-5" data-test="providers">
            {% for provider in providers %}
                <li
                    data-provider-filter-target="provider"
                    data-region="{{ provider.region.value }}"
                    {% if region and provider.region != region %}hidden{% endif %}
                >
                    <form method="post" action="{{ path('provider_start', {id: provider.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('provider') }}" data-controller="csrf-protection">
                        <button
                            type="submit"
                            data-test="provider-{{ provider.id }}"
                            class="group relative flex w-full items-center gap-4 border {{ provider.label ? 'border-(--px-brand)/60' : 'border-(--px-line)' }} bg-(--px-panel) px-4 py-4 text-left transition-colors hover:border-(--px-brand) {{ focus }}"
                        >
                            {# The name beside it names the provider: the mark is decorative. #}
                            <span class="flex size-11 shrink-0 items-center justify-center border border-(--px-line) bg-(--px-field)" aria-hidden="true">
                                <svg class="size-6" data-test="provider-logo"><use href="#provider-{{ provider.id }}"/></svg>
                            </span>
                            <span class="flex min-w-0 flex-1 flex-col gap-1">
                                <span class="flex items-center gap-2">
                                    <span class="font-medium" data-test="provider-name">{{ provider.name }}</span>
                                    {# Shown before the name, read after it. #}
                                    <svg width="{{ flag_sizes[provider.region.value][0] }}" height="{{ flag_sizes[provider.region.value][1] }}" role="img" aria-label="{{ regions[provider.region.value] }}" class="order-first shrink-0" data-test="provider-region"><title>{{ regions[provider.region.value] }}</title><use href="#flag-{{ provider.region.value }}"/></svg>
                                </span>
                                <span class="text-sm text-(--px-text-2)">{{ descriptions[provider.id] }}</span>
                            </span>
                            {% if provider.label %}
                                <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 border border-(--px-brand) bg-(--px-field) px-2 text-[0.625rem] leading-4 tracking-wider whitespace-nowrap text-(--px-brand) uppercase" data-test="provider-label">{{ labels[provider.label.value] }}</span>
                            {% endif %}
                            <svg viewBox="0 0 24 24" class="size-5 shrink-0 fill-none stroke-current stroke-2 text-(--px-text-2) transition-colors group-hover:text-(--px-brand)" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </form>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="{{ directory_url }}" class="flex h-11 items-center justify-center gap-2 border border-(--px-line) text-sm sm:flex-1 transition-colors hover:border-(--px-brand) {{ focus }}">{{ 'providers.link.directory'|trans }}<span aria-hidden="true">↗</span></a>
        <a href="{{ self_hosting_url }}" class="flex h-11 items-center justify-center gap-2 border border-(--px-line) text-sm sm:flex-1 transition-colors hover:border-(--px-brand) {{ focus }}">{{ 'providers.link.self_hosting'|trans }}<span aria-hidden="true">↗</span></a>
    </div>

    <p class="mt-8 text-sm text-(--px-text-2)">
        {{ 'providers.have_account'|trans }}
        <a href="{{ path('login') }}" class="inline-flex min-h-11 items-center text-(--px-brand) underline-offset-4 hover:underline {{ focus }}">{{ 'providers.sign_in'|trans }}</a>
    </p>
{% endblock %}
