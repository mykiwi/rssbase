{% extends 'site.html.twig' %}

{% block title %}{{ 'home.page_title'|trans }}{% endblock %}

{% block page %}
    {% set focus = 'outline-offset-2 outline-(--px-brand) focus-visible:outline-2' %}

    <div
        class="relative isolate flex flex-1 flex-col overflow-hidden"
        data-controller="pixel-field"
        data-action="pointermove->pixel-field#point pointerleave->pixel-field#release pointerdown->pixel-field#ripple"
    >
        <canvas data-pixel-field-target="canvas" class="pointer-events-none absolute inset-0 -z-10 size-full opacity-70" aria-hidden="true"></canvas>

        <twig:Site:Header />

        <main class="flex flex-1 flex-col items-center justify-center px-4 pt-8 pb-24 text-center sm:px-6">
            <div data-pixel-field-target="calm" class="flex flex-col items-center">
                <h1 class="max-w-5xl text-4xl leading-[1.1] font-semibold tracking-tighter text-balance sm:text-6xl lg:text-7xl">
                    {{ 'home.title.reader'|trans }}
                    <span class="text-(--px-brand) sm:block">{{ 'home.title.internet'|trans }}</span>
                    <span class="sm:block">{{ 'home.title.protocol'|trans }}</span>
                </h1>

                <a href="{{ path('login') }}" data-action="pointerenter->pixel-field#emit focus->pixel-field#emit" class="mt-12 inline-flex h-12 items-center bg-(--px-brand) px-8 font-medium text-(--px-brand-ink) transition-colors hover:bg-(--px-brand-high) active:scale-[0.96] {{ focus }}">{{ 'home.start'|trans }}</a>
            </div>
        </main>
    </div>
{% endblock %}
