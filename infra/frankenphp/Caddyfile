# Paths are relative to the working directory: start FrankenPHP from app/.
{
	admin {$CADDY_ADMIN:localhost:2019}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

# Restart the workers when the code changes. var/ is left out: Symfony writes PHP files there,
# and config/reference.php is regenerated with the container.
(watch_code) {
	watch ./src/**/*.php
	watch ./config/**/*.{yaml,yml}
	watch ./config/bundles.php
	watch ./templates/**/*.twig
	watch ./translations/**/*.yaml
	watch ./.env*
	watch ./vendor/composer/installed.json
}

# Development only: hot_reload tells the browser, through the Mercure hub, that a watched file
# changed. The stylesheet is watched where Tailwind builds it, later than the template it reads.
(hot_reload_hub) {
	mercure {
		anonymous
		transport local
	}
}

(hot_reload) {
	hot_reload {
		import watch_code
		watch ./assets/**/*.{js,css}
		watch ./var/tailwind/*.css
	}
}

{$SERVER_NAME:http://localhost:8000} {
	bind {$SERVER_BIND:127.0.0.1 [::1]}

	root public/
	encode zstd br gzip

	{$CADDY_SITE_CONFIG}

	php_server {
		{$FRANKENPHP_SITE_CONFIG}
		worker {
			file ./public/index.php
			{$FRANKENPHP_WORKER_CONFIG}
		}
	}
}
